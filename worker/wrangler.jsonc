{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "diaoorg-onboarding",
  "main": "index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://diaoorg.github.io",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFmKHrxpqxO6EDqy"
  },
  "ratelimits": [
    {
      "name": "IP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "EMAIL_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "account_id": "5b19d711324930ec9b47f7dca179638a"
}
